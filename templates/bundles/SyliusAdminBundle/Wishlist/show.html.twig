{# templates/admin/wishlist/show.html.twig #}

{% extends '@SyliusAdmin/layout.html.twig' %}

{% block title %}Wishlist{% endblock %}

{% block content %}
    <h1>Wishlist Admin</h1>

    <p>Aqui você pode gerenciar a wishlist dos usuarios.</p>
    {# Afficher ici les informations de la wishlist #}

    {# Exemple : afficher une liste de wishlists ou des informations associées #}
    <ul>
        {% for item in wishlist %}
            <li>{{ item.name }} - {{ item.price }}</li>
        {% endfor %}
    </ul>
{% endblock %}
