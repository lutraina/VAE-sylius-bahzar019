<!DOCTYPE html>
<html lang="{{ app.request.locale|slice(0, 2) }}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <meta name="description" content="Découvrez notre sélection de produits de qualité sur {{ sylius.channel.name }}. Achetez en ligne et profitez de nos offres exclusives.">
    <meta name="keywords" content="produits, boutique en ligne, {{ sylius.channel.name }}">

    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">

    <!-- Open Graph Tags -->
    <meta property="og:title" content="{% block title %}{{ sylius.channel.name }} | Brechó Campineiro{% endblock %}" />
    <meta property="og:description" content="Découvrez notre sélection de produits de qualité sur {{ sylius.channel.name }}. Achetez en ligne et profitez de nos offres exclusives." />

    <!-- Récupérer l'URL de l'image du produit -->


    <meta property="og:url" content="{{ app.request.uri }}" />

    <meta property="og:price:currency" content="EUR" />
    <meta property="og:availability" content="in_stock" />
    <meta property="og:condition" content="used" />
    <meta property="og:site_name" content="{{ sylius.channel.name }}" />

    <!-- Optionnel : Ajouter une catégorie populaire pour les produits -->
    <meta property="og:categoria" content="Venda de ocasião : roupas femininas, roupas masculinas, calçados, chapéus, acessórios e bolsas." />

    <!-- Optionnel : Mentionner les avantages de l'achat d'occasion -->
    <meta property="og:description" content="Réduisez votre empreinte écologique et économisez avec nos produits d'occasion." />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:description" content="Découvrez notre sélection de produits de qualité sur {{ sylius.channel.name }}. Achetez en ligne et profitez de nos offres exclusives." />


    {% block metatags '' %}

    {% block stylesheets %}
        {{ sylius_template_event('sylius.shop.layout.stylesheets') }}
    {% endblock %}

    {{ sylius_template_event('sylius.shop.layout.head') }}
</head>

<body class="d-flex flex-column min-vh-100 border-top border-5 border-primary">
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P8Z6N66L"
                  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

{{ sylius_template_event('sylius.shop.layout.before_body') }}

{% block top %}
    <nav class="navbar navbar-expand-lg border-bottom border-gray-200">
        <div class="container">
            {{ sylius_template_event('sylius.shop.layout.topbar') }}
        </div>
    </nav>
{% endblock %}

{% block header %}
    {{ sylius_template_event('sylius.shop.layout.header') }}
    {{ sylius_template_event('sylius.shop.layout.after_header') }}
    <div class="mb-4"></div>
{% endblock %}

<div class="main-content container" style="min-height: 50vh">
    <!-- Ajout de la balise <h1> pour le sujet principal de la page -->
    <h1 class="page-title">{{ sylius.channel.name }} - Découvrez nos produits</h1>

    {% include '@SyliusShop/_flashes.html.twig' %}
    {{ sylius_template_event('sylius.shop.layout.before_content') }}
    {% block content %}
    {% endblock %}
    {{ sylius_template_event('sylius.shop.layout.after_content') }}
</div>

{% block footer %}
    {% include '@SyliusShop/_footer.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ sylius_template_event('sylius.shop.layout.javascripts') }}
{% endblock %}

{{ sylius_template_event('sylius.shop.layout.after_body') }}

<div class="loading-overlay" data-js-loading-overlay>
    <div class="spinner-border" role="status">
        <span class="sr-only">Loading...</span>
    </div>
</div>

</body>
</html>
